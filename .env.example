# OpenAI API Key (선택사항 - Single Agent 비교 실험용)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Gemini API Key (선택사항 - Single Agent 비교 실험용)
GOOGLE_API_KEY=your-google-api-key-here

# Ollama 호스트 설정
# 로컬 실행 시: http://localhost:11434
# Docker 실행 시: http://host.docker.internal:11434
OLLAMA_HOST=http://host.docker.internal:11434

# Multi-Agent System에서 사용할 LLM 설정
MAS_LLM_BACKEND=ollama
MAS_LLM_MODEL=Llama-PcapLog-Tool

# Redis 설정 (Docker Compose가 자동 설정)
REDIS_HOST=redis
REDIS_PORT=6379

# Pub/Sub 메시지 로그 경로
PUBSUB_LOG_PATH=results/pubsub_messages.jsonl
